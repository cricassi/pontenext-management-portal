# Supabase project URL, for example: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key. This key is safe for browser clients under RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server/bootstrap only; never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=
